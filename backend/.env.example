# =========================================
# СЪРВЪР
# =========================================
PORT=5000
NODE_ENV=development
# Адрес на frontend-а (използва се в линковете в имейлите)
APP_URL=http://localhost:5173

# =========================================
# MONGODB
# =========================================
# Заменете <db_password> с паролата на потребителя faxyhitz1_db_user
MONGO_URI=mongodb+srv://faxyhitz1_db_user:<db_password>@cluster0.hwnvypk.mongodb.net/
MONGO_DB_NAME=e-commerce-template-2

# =========================================
# JWT
# =========================================
# Сменете с дълги случайни низове (напр. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# =========================================
# CLOUDINARY
# =========================================
# Cloud name се вижда в Cloudinary Dashboard -> Product Environment Settings
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>
CLOUDINARY_FOLDER=E-Commerce-Template-2

# =========================================
# МАГАЗИН (цени, доставка, ДДС)
# =========================================
STORE_NAME=Магазин
STORE_EMAIL=hello@example.bg
CURRENCY=EUR
# ДДС ставка (0.2 = 20%)
TAX_RATE=0.2
# true = цените в админ панела са с включено ДДС
PRICES_INCLUDE_TAX=true
SHIPPING_FEE=5.99
FREE_SHIPPING_THRESHOLD=50

# =========================================
# ИМЕЙЛ (SMTP) – по желание
# =========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Магазин <no-reply@example.bg>"
